# Add this block to /etc/caddy/Caddyfile on the VPS, then reload Caddy with:
#   sudo systemctl reload caddy
#
# Caddy auto-provisions a Let's Encrypt cert thanks to the global `email`
# already set at the top of the existing Caddyfile.

loopstat.tech {
  reverse_proxy localhost:3001
  encode gzip zstd
}
