# Production env file — used by docker compose on the VPS.
# Copy to .env.production, fill the values, NEVER commit.

# Spotify Developer App — https://developer.spotify.com/dashboard
# Same app as dev is fine; just ADD the prod redirect URI to its list:
#   https://loopstat.tech/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth — fresh prod secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical app URL in prod. MUST match the Spotify redirect URI's origin.
AUTH_URL=https://loopstat.tech

# Postgres password — generate with: openssl rand -hex 24
# Used to initialise the Postgres container AND to build DATABASE_URL inside
# docker-compose; you don't need a separate DATABASE_URL variable.
POSTGRES_PASSWORD=

# Token encryption key — fresh prod key, never reused from dev.
# 64 hex chars (= 32 bytes) for AES-256-GCM. Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=
