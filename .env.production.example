# Production env file — used by docker compose on the VPS.
# Copy to .env.production, fill the values, NEVER commit.
# Recommended: chmod 600 .env.production after creation.

# ----------------------------------------------------------------------------
# Auth (Google OAuth via NextAuth)
# ----------------------------------------------------------------------------
# Google Cloud Console → APIs & Credentials → OAuth 2.0 Client IDs.
# Same OAuth app as dev is fine; ADD the prod redirect URI:
#   https://loopstat.tech/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — FRESH prod secret. NEVER reuse dev. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Canonical app URL in prod. MUST match Google redirect URI's origin.
AUTH_URL=https://loopstat.tech

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Postgres password — generate with: openssl rand -hex 24
# Used to initialise the Postgres container AND to build DATABASE_URL inside
# docker-compose; you don't need a separate DATABASE_URL variable.
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------
# Stripe (Premium subscription payments)
# ----------------------------------------------------------------------------
# Use LIVE keys for prod, NOT test keys.
# Dashboard → Developers → API keys / Webhooks / Products
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# ----------------------------------------------------------------------------
# Catalog enrichment (Deezer)
# ----------------------------------------------------------------------------
# Deezer Open API needs no key for the scope we use (/search/*, /album/{id}).
