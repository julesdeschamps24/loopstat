# Google OAuth — https://console.cloud.google.com/apis/credentials
# Voir docs/google-auth-setup.md pour la procédure
# Redirect URI to register: http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://loopstat:loopstat@127.0.0.1:5432/loopstat

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379


