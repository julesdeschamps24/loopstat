# Spotify Developer App — https://developer.spotify.com/dashboard
# Redirect URI to register: http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://stat_fm:stat_fm@127.0.0.1:5432/stat_fm

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Token encryption key — generate with: openssl rand -hex 32
# 64 hex chars = 32 bytes for AES-256-GCM
TOKEN_ENC_KEY=
